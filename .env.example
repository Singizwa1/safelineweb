# Copy this file to .env and fill in real values. .env itself is gitignored -
# never commit it. This site has no Composer/vendor dependencies, so .env is
# parsed by the tiny loadEnv() in includes/config.php rather than a package.

# Backend API this site calls for categories, ride prices, and Intercity
# trips/bookings. Local dev note: use 127.0.0.1, not "localhost" - see the
# comment above $safeline_api_base in includes/config.php for why.
SAFELINE_API_BASE=https://demo.safeline.rw/safeLine-api

# Inbox that receives contact-form submissions (see the note above
# $form_delivery_email in includes/config.php - this is NOT the public
# $contact_email shown to visitors).
FORM_DELIVERY_EMAIL=
